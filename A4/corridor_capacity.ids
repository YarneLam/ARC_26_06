<?xml version="1.0" encoding="UTF-8"?>
<ids xmlns="http://standards.buildingsmart.org/IDS"
     xmlns:xs="http://www.w3.org/2001/XMLSchema"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://standards.buildingsmart.org/IDS https://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <info>
    <title>ARCH06 IFC inputs for corridor capacity</title>
    <version>1.1</version>
    <description>Checks space and door inputs for the whole IFC. The Python tool checks corridor labels, usable footprints and room-to-door connections.</description>
  </info>
  <specifications>
    <specification name="Spaces assigned to building storeys" ifcVersion="IFC4 IFC4X3_ADD2">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCSPACE</simpleValue></name></entity>
      </applicability>
      <requirements>
        <partOf relation="IFCRELAGGREGATES" cardinality="required">
          <entity><name><simpleValue>IFCBUILDINGSTOREY</simpleValue></name></entity>
        </partOf>
      </requirements>
    </specification>
    <specification name="Door identities for adjacency screening" ifcVersion="IFC4 IFC4X3_ADD2">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCDOOR</simpleValue></name></entity>
      </applicability>
      <requirements>
        <attribute cardinality="required"><name><simpleValue>GlobalId</simpleValue></name></attribute>
      </requirements>
    </specification>
    <specification name="Net floor area when supplied" ifcVersion="IFC4 IFC4X3_ADD2">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCSPACE</simpleValue></name></entity>
        <property>
          <propertySet>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Qto_SpaceBaseQuantities"/>
              <xs:enumeration value="BaseQuantities"/>
            </xs:restriction>
          </propertySet>
          <baseName><simpleValue>NetFloorArea</simpleValue></baseName>
        </property>
      </applicability>
      <requirements>
        <property dataType="IFCAREAMEASURE" cardinality="required">
          <propertySet>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Qto_SpaceBaseQuantities"/>
              <xs:enumeration value="BaseQuantities"/>
            </xs:restriction>
          </propertySet>
          <baseName><simpleValue>NetFloorArea</simpleValue></baseName>
        </property>
      </requirements>
    </specification>
  </specifications>
</ids>
